<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
 office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
  <office:font-face-decls>
    <style:font-face style:name="맑은 고딕" svg:font-family="'맑은 고딕'"/>
  </office:font-face-decls>
  <office:automatic-styles>
    <style:style style:name="P1" style:family="paragraph">
      <style:text-properties style:font-name="맑은 고딕" fo:font-size="12pt"
        style:font-name-asian="맑은 고딕" style:font-size-asian="12pt"/>
    </style:style>
  </office:automatic-styles>
  <office:body><office:text>
    <text:h text:outline-level="1">제목입니다 Heading</text:h>
    <text:p text:style-name="P1">본문 문단.</text:p>
    <table:table table:name="T1">
      <table:table-column/>
      <table:table-row><table:table-cell><text:p>셀</text:p></table:table-cell></table:table-row>
    </table:table>
    <text:p><draw:frame svg:width="2cm" svg:height="2cm"><draw:text-box><text:p>프레임</text:p></draw:text-box></draw:frame>프레임 뒤 텍스트</text:p>
    <text:list><text:list-item><text:p>목록 항목</text:p></text:list-item></text:list>
  </office:text></office:body>
</office:document>